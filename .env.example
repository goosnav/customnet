# Local-only by default. No API key is needed for Hacker News.
HOST=127.0.0.1
PORT=4311
# Required for a non-local origin behind an authenticated reverse proxy.
# APP_ORIGIN=https://customnet.example.com

# Optional: web, shopping discovery, indexed public social links
# BRAVE_API_KEY=
# Optional: direct video search (HN-linked YouTube works without it)
# YOUTUBE_API_KEY=

# Optional: OpenAI-compatible /chat/completions service.
# Base URL includes /v1 when required. Local models can omit API_KEY.
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=your-model-name
# AI_API_KEY=
